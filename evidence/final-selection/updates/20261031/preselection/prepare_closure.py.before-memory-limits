before = D / 'navigation-completion-before'
after = D / 'navigation-completion-after'
before.mkdir()
after.mkdir()
rows = []
for rel, prefix in prefixes.items():
    p = R / rel
    old = p.read_bytes()
    (before / rel).write_bytes(old)
    newbytes = prefix.encode() + old
    p.write_bytes(newbytes)
    (after / rel).write_bytes(newbytes)
    rows.append({'path': rel, 'before_sha256': sha(old), 'after_sha256': sha(newbytes)})
save(D / 'NAVIGATION_VERIFICATION.json', {'files': rows, 'additive_only': True, 'recorded_at': datetime.now(timezone.utc).isoformat()})
print(json.dumps({'status': 'CLOSURE_FILES_PREPARED_NOT_YET_ACCEPTED', 'counts': reg['counts'], 'roles': roles['count']}))
