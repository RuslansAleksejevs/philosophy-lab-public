      "decision": {
        "closest_works": [
          {
            "citation": "Hirschman 1970, Exit, Voice, and Loyalty, ch.4 pp.51–55",
            "difference": "Conditional separation of valid renewal jurisdiction from enduring accountability to experimental subjects after lost membership.",
            "evidence_path": "sources/primary4.json",
            "shared_claim": "Selective exit drains voice; mechanism inherited."
          },
          {
            "citation": "Kuyper 2013, Designing institutions for global democracy, pp.198–203",
            "difference": "Counterexample where membership loss makes renewal unable to fulfill original review assurance despite two valid votes; does not apply where temporary escape retains standing.",
            "evidence_path": "sources/primary4.json",
            "shared_claim": "Exit and sunset/renegotiation provisions support experiments and correction."
          },
          {
            "citation": "Goodin 2024, Proximity Principle, Adieu, opening sections",
            "difference": "Issue-specific trial-accountability process without freezing electorate for future governance; promise/continuity ground rather than general franchise expansion.",
            "evidence_path": "sources/primary2.json",
            "shared_claim": "Jurisdiction and franchise must track morally relevant relations, not merely geography."
          },
          {
            "citation": "Farrow 2007, European Constitutionalism and Retrospective Legitimacy, pp.10–13",
            "difference": "Grants unanimous trial consent and valid renewal; identifies failure of retained review rights in between.",
            "evidence_path": "sources/primary3.json",
            "shared_claim": "Later democratic acceptance need not legitimate earlier institutional imposition."
          },
          {
            "citation": "Francis 2017, Exit Legitimacy, abstract",
            "difference": "Compatible prospective benefit does not alone settle past accountability; full-paper overlap uncertain.",
            "evidence_path": "sources/s4.json",
            "shared_claim": "Exit strengthens consent/autonomy."
          }
        ],
        "limitations": "Bounded English search and selected primary excerpts, not absolute novelty. Francis abstract only; Goodin 2007 inaccessible. Elementary selection bias and persistence of obligations are not claimed new. Independent critic must decide whether the conjunction yields sufficient contribution.",
